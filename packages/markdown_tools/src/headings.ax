module markdown_tools.headings;

struct HeadingSummary {
    headings: i32,
    h1: i32,
    h2: i32,
    body_lines: i32,
}

fn is_heading(line: string) -> bool {
    return string_starts_with(string_trim(line), "#");
}

fn is_h1(line: string) -> bool {
    let trimmed: string = string_trim(line);
    if (string_starts_with(trimmed, "# ")) {
        return true;
    }
    return false;
}

fn is_h2(line: string) -> bool {
    let trimmed: string = string_trim(line);
    if (string_starts_with(trimmed, "## ")) {
        return true;
    }
    return false;
}

fn count_headings(markdown: string) -> i32 {
    let lines: [string] = string_split_lines(markdown);
    let mut count: i32 = 0;
    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        if (is_heading(lines[i])) {
            count = count + 1;
        }
    }
    return count;
}

fn summarize(markdown: string) -> HeadingSummary {
    let lines: [string] = string_split_lines(markdown);
    let mut summary: HeadingSummary = HeadingSummary { headings: 0, h1: 0, h2: 0, body_lines: 0 };
    for (let mut i: i32 = 0; i < len(lines); i = i + 1) {
        let line: string = lines[i];
        if (is_heading(line)) {
            summary.headings = summary.headings + 1;
            if (is_h1(line)) {
                summary.h1 = summary.h1 + 1;
            }
            if (is_h2(line)) {
                summary.h2 = summary.h2 + 1;
            }
        } else {
            if (string_len(string_trim(line)) != 0) {
                summary.body_lines = summary.body_lines + 1;
            }
        }
    }
    return summary;
}
