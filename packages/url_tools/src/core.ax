module url_tools.core;

struct UrlSummary {
    valid: bool,
    secure: bool,
    scheme: string,
    default_port: i32,
}

fn is_http_url(url: string) -> bool {
    return string_starts_with(url, "http://") || string_starts_with(url, "https://");
}

fn is_secure(url: string) -> bool {
    return string_starts_with(url, "https://");
}

fn scheme(url: string) -> string {
    if (string_starts_with(url, "https://")) {
        return "https";
    }
    if (string_starts_with(url, "http://")) {
        return "http";
    }
    return "unknown";
}

fn default_port(url: string) -> i32 {
    if (string_starts_with(url, "https://")) {
        return 443;
    }
    if (string_starts_with(url, "http://")) {
        return 80;
    }
    return -1;
}

fn ensure_path(path: string) -> string {
    if (string_len(path) == 0) {
        return "/";
    }
    if (string_starts_with(path, "/")) {
        return path;
    }
    return "/" + path;
}

fn query_pair(key: string, value: string) -> string {
    return key + "=" + value;
}

fn append_query(url: string, query: string) -> string {
    if (string_len(query) == 0) {
        return url;
    }
    if (string_contains(url, "?")) {
        return url + "&" + query;
    }
    return url + "?" + query;
}

fn summarize(url: string) -> UrlSummary {
    return UrlSummary {
        valid: is_http_url(url),
        secure: is_secure(url),
        scheme: scheme(url),
        default_port: default_port(url),
    };
}
