module collection_tools.ints;

struct IntSummary {
    count: i32,
    sum: i32,
    min: i32,
    max: i32,
}

fn sum(values: [i32]) -> i32 {
    let mut total: i32 = 0;
    for (let mut i: i32 = 0; i < len(values); i = i + 1) {
        total = total + values[i];
    }
    return total;
}

fn min_or(values: [i32], fallback: i32) -> i32 {
    if (len(values) == 0) {
        return fallback;
    }
    let mut value: i32 = values[0];
    for (let mut i: i32 = 1; i < len(values); i = i + 1) {
        if (values[i] < value) {
            value = values[i];
        }
    }
    return value;
}

fn max_or(values: [i32], fallback: i32) -> i32 {
    if (len(values) == 0) {
        return fallback;
    }
    let mut value: i32 = values[0];
    for (let mut i: i32 = 1; i < len(values); i = i + 1) {
        if (values[i] > value) {
            value = values[i];
        }
    }
    return value;
}

fn average_floor(values: [i32]) -> i32 {
    if (len(values) == 0) {
        return 0;
    }
    return sum(values) / len(values);
}

fn summarize(values: [i32]) -> IntSummary {
    return IntSummary {
        count: len(values),
        sum: sum(values),
        min: min_or(values, 0),
        max: max_or(values, 0),
    };
}
